FROM python:3.10-slim

# System dependencies for opencv
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1-mesa-glx && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /recognition_service

COPY recognition_service/ .

RUN pip install --no-cache-dir -r requirements.txt

# HTTP (FastAPI) + gRPC ports
EXPOSE 8002 50051

CMD ["python3", "main.py"]

### build this service
# docker build -t recognition . -f Dockerfile.recognition

# run (no GPU needed — recognition is orchestrator only)
# docker run -it --name recognition_service --net camera_track_network -v ./static_files:/static_files -p 8002:8002 -p 50051:50051 recognition
